{
  "name": "@t2e/precut",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "author": "T2ETECH",
  "description": "Skip the boring first edit.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify:sdk": "node vendor/verify-package.mjs vendor/manifest.json vendor/manifest.sig vendor/sdk-release-public-key.json",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm verify:sdk && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:e2e": "pnpm build && playwright test",
    "test:media": "node scripts/media-smoke.mjs",
    "native:prepare": "node scripts/prepare-native.mjs",
    "native:speech": "node scripts/build-speech-native.mjs",
    "test:speech-benchmark": "node scripts/speech-benchmark.mjs",
    "native:verify": "node scripts/verify-native.mjs",
    "models:prepare": "node scripts/prepare-models.mjs",
    "package:dir": "pnpm build && pnpm native:verify && electron-builder --dir",
    "package": "pnpm build && pnpm native:verify && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "preinstall": "node vendor/verify-package.mjs vendor/manifest.json vendor/manifest.sig vendor/sdk-release-public-key.json",
    "fixtures:prepare": "node scripts/prepare-fixtures.mjs",
    "format": "prettier --write apps packages scripts tests *.ts *.json",
    "icons:prepare": "node scripts/generate-icons.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:upload": "node scripts/release-upload.mjs",
    "release:manual": "node scripts/manual-release.mjs",
    "notices:prepare": "node scripts/collect-notices.mjs",
    "start:unpackaged": "pnpm build && electron .",
    "native:translation": "node scripts/build-translation-native.mjs",
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "fonts:verify": "node scripts/verify-fonts.mjs",
    "captions:assets": "node scripts/prepare-caption-animations.mjs",
    "captions:browser": "node scripts/prepare-caption-browser.mjs",
    "captions:previews": "node scripts/render-caption-previews.mjs",
    "test:captions:packaged": "node scripts/caption-packaged-smoke.mjs",
    "test:captions:long": "node scripts/caption-packaged-smoke.mjs --long",
    "test:translation": "vitest run tests/integration/translation-native.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "@hyperframes/core": "0.8.156",
    "@hyperframes/engine": "0.8.156",
    "@hyperframes/player": "0.8.156",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@t2e/license-sdk": "file:./vendor/t2e-license-sdk-1.0.0-rc.1.tgz",
    "@tanstack/react-virtual": "3.14.13",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.14.2",
    "lucide-react": "1.52.0",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "skia-canvas": "3.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "acorn": "8.15.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.t2etech.precut",
    "productName": "Precut",
    "artifactName": "precut-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "package.json",
      "product.config.json",
      "!node_modules/@t2e/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/@radix-ui/**",
      "!node_modules/@fontsource/**",
      "!node_modules/lucide-react/**",
      "!node_modules/zustand/**"
    ],
    "extraResources": [
      {
        "from": "native/models",
        "to": "models"
      },
      {
        "from": "apps/desktop/public/fonts",
        "to": "fonts"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "protocols": [
      {
        "name": "Precut account login",
        "schemes": [
          "com.t2etech.precut"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "native/darwin-${arch}",
          "to": "native"
        }
      ],
      "icon": "build/icon.icns",
      "minimumSystemVersion": "27.0.0"
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "native/win32-${arch}",
          "to": "native"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib",
      "**/*.dll"
    ]
  }
}
